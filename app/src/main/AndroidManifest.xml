<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RentReady">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AppData"
            android:exported="false"
            android:label="@string/title_activity_app_data"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Components"
            android:exported="false"
            android:label="@string/title_activity_components"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".HomeScreen"
            android:exported="false"
            android:label="@string/title_activity_home_screen"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DetailsScreen"
            android:exported="false"
            android:label="@string/title_activity_details_screen"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReservationsScreen"
            android:exported="false"
            android:label="@string/title_activity_reservations_screen"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RentalsScreen"
            android:exported="false"
            android:label="@string/title_activity_rentals_screen"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ProfileScreen"
            android:exported="false"
            android:label="@string/title_activity_profile_screen"
            android:theme="@style/Theme.RentReady"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>